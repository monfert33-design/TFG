<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:tcg.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="750"
        x:Class="tcg.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="DFIR SOC Dashboard - Incident Triage"
        Background="#0F141C"
        Foreground="#E2E8F0"
        WindowStartupLocation="CenterScreen">

    <!-- CONTENEDOR PRINCIPAL: SPLITVIEW PARA EL MENÚ LATERAL -->
    <SplitView IsPaneOpen="{Binding IsSidebarOpen}"
               CompactPaneLength="58"
               OpenPaneLength="200"
               DisplayMode="CompactInline"
               Background="#0F141C">

        <!-- ================= 1. MENÚ LATERAL ================= -->
        <SplitView.Pane>
            <Border Background="#161E2E" BorderBrush="#243046" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Botón superior -->
                    <Button Grid.Row="0"
                            Command="{Binding ToggleSidebarCommand}"
                            Background="Transparent"
                            HorizontalAlignment="Stretch"
                            Padding="16,16"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock Text="☰" FontSize="18" FontWeight="Bold" Foreground="#38BDF8"/>
                            <TextBlock Text="SOC DFIR" FontWeight="Bold" FontSize="15" 
                                       IsVisible="{Binding IsSidebarOpen}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Lista de Navegación -->
                    <StackPanel Grid.Row="1" Spacing="6" Margin="6,15,6,0">
                        <Button Background="#1E293B" HorizontalAlignment="Stretch" Padding="12,10" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <TextBlock Text="🏠" FontSize="16"/>
                                <TextBlock Text="Incidentes" FontWeight="SemiBold" IsVisible="{Binding IsSidebarOpen}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Background="Transparent" HorizontalAlignment="Stretch" Padding="12,10" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <TextBlock Text="🛡" FontSize="16"/>
                                <TextBlock Text="Auditoría" FontWeight="SemiBold" IsVisible="{Binding IsSidebarOpen}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Background="Transparent" HorizontalAlignment="Stretch" Padding="12,10" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <TextBlock Text="📁" FontSize="16"/>
                                <TextBlock Text="Evidencias" FontWeight="SemiBold" IsVisible="{Binding IsSidebarOpen}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Configuración Inferior -->
                    <Button Grid.Row="2" Background="Transparent" HorizontalAlignment="Stretch" Margin="6,0,6,12" Padding="12,10" CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <TextBlock Text="⚙" FontSize="16"/>
                            <TextBlock Text="Ajustes" FontWeight="SemiBold" IsVisible="{Binding IsSidebarOpen}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </SplitView.Pane>

        <!-- ================= 2. PANTALLA PRINCIPAL (HOME) ================= -->
        <Grid RowDefinitions="Auto,*,Auto" Margin="20,16,20,16">

            <!-- CABECERA: BUSCADOR, TOGGLE AUTO-SCAN Y BOTÓN ANALIZAR -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,16">
                <!-- Buscador / Filtrador -->
                <TextBox Grid.Column="0"
                    Text="{Binding SearchText}"
                    Watermark="🔍 Filtrar por IP, caso, severidad o técnica MITRE..."
                    Background="#161E2E"
                    Foreground="White"
                    BorderBrush="#2B3954"
                    CornerRadius="8"
                    Padding="12,8"
                    FontSize="14"
                    Margin="0,0,12,0"/>

                <!-- Botón Activar / Pausar Auto-Scan (30s) -->
                <Button Grid.Column="1"
                    Command="{Binding ToggleAutoScanCommand}"
                    Background="#1E293B"
                    Foreground="#38BDF8"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    Padding="14,8"
                    CornerRadius="8"
                    Cursor="Hand"
                    Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="🔄" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding IsAutoScanActive, Converter={x:Null}, StringFormat='Auto-Scan: {0}'}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Botón de extracción manual inmediata -->
                <Button Grid.Column="2"
                    Command="{Binding TriggerAnalysisCommand}"
                    IsEnabled="{Binding !IsLoading}"
                    Background="#0284C7"
                    Foreground="White"
                    FontWeight="Bold"
                    Padding="16,8"
                    CornerRadius="8"
                    Cursor="Hand">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="⚡" VerticalAlignment="Center"/>
                        <TextBlock Text="Forzar Análisis" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- CONTENIDO CENTRAL: LAS DOS COLUMNAS -->
            <Grid Grid.Row="1" ColumnDefinitions="380,*" Margin="0,0,0,16">

                <!-- COLUMNA 1: LISTA DE AMENAZAS / INCIDENTES REGISTRADOS -->
                <Border Grid.Column="0" 
                        Background="#161E2E" 
                        BorderBrush="#243046" 
                        BorderThickness="1" 
                        CornerRadius="10" 
                        Padding="10"
                        Margin="0,0,12,0">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0" Text="Histórico de Incidentes" FontWeight="Bold" FontSize="14" Margin="4,2,0,8" Foreground="#94A3B8"/>
                        
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding FilteredCases}"
                                 SelectedItem="{Binding SelectedCase}"
                                 Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1E293B" 
                                            BorderBrush="#334155" 
                                            BorderThickness="1" 
                                            CornerRadius="8" 
                                            Padding="10" 
                                            Margin="0,0,0,6">
                                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                                            <!-- Indicador visual -->
                                            <Border Grid.RowSpan="2" Grid.Column="0" Width="4" CornerRadius="2" Margin="0,0,10,0"
                                                    Background="{Binding DictamenPericial.AtaqueDetectado, Converter={x:Null}}">
                                                <!-- Truco de color directo: Rojo para ataque, Verde para legítimo -->
                                            </Border>

                                            <TextBlock Grid.Row="0" Grid.Column="1" 
                                                       Text="{Binding DictamenPericial.TipoAtaque}" 
                                                       FontWeight="Bold" 
                                                       Foreground="#F8FAFC"/>
                                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding DictamenPericial.IpAtacante, TargetNullValue='IP: Local'}" 
                                                           Foreground="#38BDF8" FontSize="12"/>
                                                <TextBlock Text="{Binding DictamenPericial.Severidad}" 
                                                           Foreground="#EF4444" FontWeight="Bold" FontSize="12"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- COLUMNA 2: DETALLE DEL INCIDENTE SELECCIONADO -->
                <Border Grid.Column="1" 
                        Background="#161E2E" 
                        BorderBrush="#243046" 
                        BorderThickness="1" 
                        CornerRadius="10" 
                        Padding="20">
                    <ScrollViewer>
                        <StackPanel Spacing="16" IsVisible="{Binding SelectedCase, Converter={x:Static ObjectConverters.IsNotNull}}">
                            
                            <!-- Cabecera de caso -->
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding SelectedCase.CasoId}" FontSize="20" FontWeight="Bold" Foreground="#38BDF8"/>
                                    <TextBlock Text="{Binding SelectedCase.TimestampAnalisis, StringFormat='Fecha de adquisición: {0:yyyy-MM-dd HH:mm:ss} UTC'}" 
                                               Foreground="#64748B" FontSize="12"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#7F1D1D" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedCase.DictamenPericial.Severidad}" FontWeight="Bold" Foreground="#F87171"/>
                                </Border>
                            </Grid>

                            <Separator Background="#243046"/>

                            <!-- Tarjetas de métricas rápidas -->
                            <UniformGrid Columns="2">
                                <Border Background="#1E293B" CornerRadius="8" Padding="12" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="IP ATACANTE" FontSize="11" Foreground="#94A3B8" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding SelectedCase.DictamenPericial.IpAtacante, TargetNullValue='N/A'}" 
                                                   FontSize="16" FontWeight="SemiBold" Foreground="#F1F5F9" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#1E293B" CornerRadius="8" Padding="12" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="TÉCNICA MITRE ATT&amp;CK" FontSize="11" Foreground="#94A3B8" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding SelectedCase.DictamenPericial.TecnicaMitre}" 
                                                   FontSize="14" FontWeight="SemiBold" Foreground="#F1F5F9" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Hash de integridad forense -->
                            <Border Background="#1E293B" CornerRadius="8" Padding="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="INTEGRIDAD FORENSE (SHA-256 EVIDENCIA CRUDA)" FontSize="11" Foreground="#94A3B8" FontWeight="Bold"/>
                                    <TextBox Text="{Binding SelectedCase.EvidenciaSha256}" 
                                             IsReadOnly="True" 
                                             BorderThickness="0" 
                                             Background="#0F141C" 
                                             Foreground="#34D399" 
                                             FontFamily="Consolas, Monospace" 
                                             FontSize="12"/>
                                </StackPanel>
                            </Border>

                            <!-- Dictamen de la IA -->
                            <Border Background="#1E293B" CornerRadius="8" Padding="14">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="DICTAMEN PERICIAL (GENERADO POR IA)" FontSize="11" Foreground="#94A3B8" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding SelectedCase.DictamenPericial.ResumenForense}" 
                                               TextWrapping="Wrap" 
                                               LineHeight="22" 
                                               Foreground="#E2E8F0"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ================= 3. PANEL INFERIOR: ACCIONES / ESTADO ================= -->
<Border Grid.Row="2" Background="#161E2E" BorderBrush="#243046" BorderThickness="1" CornerRadius="10" Padding="14,10">
    <Grid ColumnDefinitions="Auto,*,Auto">
        <!-- Indicador de estado -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="●" Foreground="#38BDF8" FontSize="14"/>
            <TextBlock Text="{Binding StatusMessage}" Foreground="#94A3B8" FontSize="13"/>
        </StackPanel>

        <!-- Propuesta de Remediación y Botón Human-in-the-Loop -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"
                    IsVisible="{Binding SelectedCase, Converter={x:Static ObjectConverters.IsNotNull}}">
            
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="Contramedida:" Foreground="#F59E0B" FontWeight="Bold" VerticalAlignment="Center"/>
                <Border Background="#0F141C" CornerRadius="4" Padding="8,4">
                    <TextBlock Text="{Binding SelectedCase.DictamenPericial.AccionPropuesta.ComandoSugerido}" 
                               FontFamily="Consolas, Monospace" 
                               Foreground="#FCD34D" 
                               VerticalAlignment="Center"/>
                </Border>
            </StackPanel>

            <!-- Botón para ejecutar la acción en el servidor Ubuntu -->
            <Button Command="{Binding ApplyRemediationActionCommand}"
                    IsEnabled="{Binding SelectedCase.DictamenPericial.AccionPropuesta.RequiereAccion}"
                    Background="#DC2626"
                    Foreground="White"
                    FontWeight="Bold"
                    Padding="12,6"
                    CornerRadius="6"
                    Cursor="Hand">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="🛡" VerticalAlignment="Center"/>
                    <TextBlock Text="Ejecutar Bloqueo" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Border>

        </Grid>
    </SplitView>
</Window>