<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:tcg.ViewModels"
        xmlns:views="using:tcg.Views"
        WindowState="Maximized"
        x:Class="tcg.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="NexGuard - Incident Response Platform"
        Background="#0F141C"
        Foreground="#E2E8F0"
        WindowStartupLocation="CenterScreen">

    <!-- CONTENEDOR PRINCIPAL: SPLITVIEW -->
    <SplitView IsPaneOpen="{Binding IsSidebarOpen}"
               CompactPaneLength="58"
               OpenPaneLength="200"
               DisplayMode="CompactInline"
               Background="#0F141C">

        <!-- ================= 1. MENÚ LATERAL PERSISTENTE ================= -->
        <SplitView.Pane>
            <Border Background="#161E2E" BorderBrush="#243046" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Botón colapsar menú -->
                    <Button Grid.Row="0"
                            Command="{Binding ToggleSidebarCommand}"
                            Background="Transparent"
                            HorizontalAlignment="Stretch"
                            Padding="16,16"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock Text="☰" FontSize="18" FontWeight="Bold" Foreground="#38BDF8"/>
                            <!-- El texto solo se muestra con el menú desplegado -->
                            <TextBlock Text="NEXGUARD" FontWeight="Bold" FontSize="15" 
                                       IsVisible="{Binding IsSidebarOpen}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Botones de Navegación -->
                    <StackPanel Grid.Row="1" Spacing="6" Margin="6,15,6,0">
                        <!-- Botón 1: Incidentes / Dashboard Principal -->
                        <Button Command="{Binding ShowDashboardCommand}"
                                Background="#1E293B" HorizontalAlignment="Stretch" Padding="12,10" CornerRadius="6" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <TextBlock Text="🏠" FontSize="16"/>
                                <TextBlock Text="Incidentes" FontWeight="SemiBold" IsVisible="{Binding IsSidebarOpen}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Botón 2: Estadísticas / Informes Globales -->
                        <Button Command="{Binding ShowReportsCommand}"
                                Background="Transparent" HorizontalAlignment="Stretch" Padding="12,10" CornerRadius="6" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <TextBlock Text="📊" FontSize="16"/>
                                <TextBlock Text="Estadísticas" FontWeight="SemiBold" IsVisible="{Binding IsSidebarOpen}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Botones 3 y 4: Auditoría y Evidencias (aún sin funcionalidad) -->
                        <Button Background="Transparent" HorizontalAlignment="Stretch" Padding="12,10" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <TextBlock Text="🛡" FontSize="16"/>
                                <TextBlock Text="Auditoría" FontWeight="SemiBold" IsVisible="{Binding IsSidebarOpen}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Background="Transparent" HorizontalAlignment="Stretch" Padding="12,10" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <TextBlock Text="📁" FontSize="16"/>
                                <TextBlock Text="Evidencias" FontWeight="SemiBold" IsVisible="{Binding IsSidebarOpen}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Botón Ajustes -->
                    <Button Grid.Row="2" Background="Transparent" HorizontalAlignment="Stretch" Margin="6,0,6,12" Padding="12,10" CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <TextBlock Text="⚙" FontSize="16"/>
                            <TextBlock Text="Ajustes" FontWeight="SemiBold" IsVisible="{Binding IsSidebarOpen}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </SplitView.Pane>

        <!-- ================= 2. CONTENIDO PRINCIPAL ================= -->
        <!-- Las dos capas comparten espacio; solo una es visible a la vez -->
        <Panel>

            <!-- ================= CAPA A: PANTALLA PRINCIPAL DE INCIDENTES ================= -->
            <Grid RowDefinitions="Auto,*,Auto" Margin="20,16,20,16" IsVisible="{Binding IsDashboardVisible}">

                <!-- CABECERA: BUSCADOR, AUTO-SCAN Y FORZAR ANÁLISIS -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,16">
                    <!-- Buscador / Filtrador -->
                    <TextBox Grid.Column="0"
                             Text="{Binding SearchText}"
                             Watermark="🔍 Filtrar por IP, caso, severidad o técnica MITRE..."
                             Background="#161E2E"
                             Foreground="White"
                             BorderBrush="#2B3954"
                             CornerRadius="8"
                             Padding="12,8"
                             FontSize="14"
                             Margin="0,0,12,0"/>

                    <!-- Activar / Pausar Auto-Scan -->
                    <Button Grid.Column="1"
                            Command="{Binding ToggleAutoScanCommand}"
                            Background="#1E293B"
                            Foreground="#38BDF8"
                            BorderBrush="#334155"
                            BorderThickness="1"
                            Padding="14,8"
                            CornerRadius="8"
                            Cursor="Hand"
                            Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="🔄" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding IsAutoScanActive, StringFormat={}Auto-Scan: {0}}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Análisis manual inmediato (se desactiva mientras carga) -->
                    <Button Grid.Column="2"
                            Command="{Binding TriggerAnalysisCommand}"
                            IsEnabled="{Binding !IsLoading}"
                            Background="#0284C7"
                            Foreground="White"
                            FontWeight="Bold"
                            Padding="16,8"
                            CornerRadius="8"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Forzar Análisis" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- CUERPO DE INCIDENTES: COLUMNA IZQUIERDA Y DETALLE DERECHO -->
                <Grid Grid.Row="1" ColumnDefinitions="380,*" Margin="0,0,0,16">

                    <!-- COLUMNA IZQUIERDA: RECIENTES Y ARCHIVADOS -->
                    <ScrollViewer Grid.Column="0" Background="#161B22">
                        <StackPanel Margin="10" Spacing="16">
                            
                            <!-- SECCIÓN RECIENTES (< 2H) -->
                            <StackPanel Spacing="6">
                                <!-- Título y contador -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="🔴 RECIENTES (&lt; 2H)"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#58A6FF"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding CurrentSessionCases.Count}"
                                               FontSize="11"
                                               Foreground="#8B949E"/>
                                </Grid>

                                <!-- Lista de casos recientes; al seleccionar uno se abre su detalle -->
                                <ListBox ItemsSource="{Binding CurrentSessionCases}"
                                         SelectedItem="{Binding SelectedCase}"
                                         Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Tarjeta: tipo de ataque, IP de origen y hora -->
                                            <Border Background="#0D1117"
                                                    BorderBrush="#30363D"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="10"
                                                    Margin="0 2">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{Binding DictamenPericial.TipoAtaque}"
                                                               FontWeight="Bold"
                                                               FontSize="12"
                                                               Foreground="#FFFFFF"/>
                                                    <TextBlock Text="{Binding DictamenPericial.IpAtacante, StringFormat={}Origen: {0}}"
                                                               FontSize="10"
                                                               Foreground="#8B949E"/>
                                                    <TextBlock Text="{Binding TimestampAnalisis, StringFormat={}{0:HH:mm:ss UTC}}"
                                                               FontSize="9"
                                                               Foreground="#58A6FF"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>

                            <!-- SECCIÓN ARCHIVADOS (≥ 2H) -->
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="📁 HISTÓRICO ANTERIOR"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#8B949E"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ArchivedCases.Count}"
                                               FontSize="11"
                                               Foreground="#8B949E"/>
                                </Grid>

                                <!-- Misma lógica que recientes, con estilo atenuado y fecha completa -->
                                <ListBox ItemsSource="{Binding ArchivedCases}"
                                         SelectedItem="{Binding SelectedCase}"
                                         Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#0D1117"
                                                    BorderBrush="#21262D"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="10"
                                                    Margin="0 2"
                                                    Opacity="0.85">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{Binding DictamenPericial.TipoAtaque}"
                                                               FontWeight="SemiBold"
                                                               FontSize="11"
                                                               Foreground="#C9D1D9"/>
                                                    <TextBlock Text="{Binding DictamenPericial.IpAtacante, StringFormat={}Origen: {0}}"
                                                               FontSize="10"
                                                               Foreground="#8B949E"/>
                                                    <TextBlock Text="{Binding TimestampAnalisis, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                                               FontSize="9"
                                                               Foreground="#8B949E"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- COLUMNA DERECHA: EXPEDIENTE FORENSE Y MITIGACIÓN -->
                    <Border Grid.Column="1" 
                            Background="#161E2E" 
                            BorderBrush="#243046" 
                            BorderThickness="1" 
                            CornerRadius="10" 
                            Padding="20">
                        <ScrollViewer>
                            <!-- Solo se muestra si hay un caso seleccionado -->
                            <StackPanel Spacing="16" IsVisible="{Binding SelectedCase, Converter={x:Static ObjectConverters.IsNotNull}}">
                                
                                <!-- Cabecera del caso: ID, fecha y severidad -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding SelectedCase.CasoId}" FontSize="20" FontWeight="Bold" Foreground="#38BDF8"/>
                                        <TextBlock Text="{Binding SelectedCase.TimestampAnalisis, StringFormat={}{0:yyyy-MM-dd HH:mm:ss} UTC}" 
                                                   Foreground="#64748B" FontSize="12"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#7F1D1D" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedCase.DictamenPericial.Severidad}" FontWeight="Bold" Foreground="#F87171"/>
                                    </Border>
                                </Grid>

                                <Separator Background="#243046"/>

                                <!-- Tarjetas rápidas: IP atacante y técnica MITRE -->
                                <UniformGrid Columns="2">
                                    <Border Background="#1E293B" CornerRadius="8" Padding="12" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="IP ATACANTE" FontSize="11" Foreground="#94A3B8" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding SelectedCase.DictamenPericial.IpAtacante, TargetNullValue=N/A}" 
                                                       FontSize="16" FontWeight="SemiBold" Foreground="#F1F5F9" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#1E293B" CornerRadius="8" Padding="12" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="TÉCNICA MITRE ATT&amp;CK" FontSize="11" Foreground="#94A3B8" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding SelectedCase.DictamenPericial.TecnicaMitre}" 
                                                       FontSize="14" FontWeight="SemiBold" Foreground="#F1F5F9" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- Hash de integridad forense (solo lectura) -->
                                <Border Background="#1E293B" CornerRadius="8" Padding="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="INTEGRIDAD FORENSE (SHA-256 EVIDENCIA CRUDA)" FontSize="11" Foreground="#94A3B8" FontWeight="Bold"/>
                                        <TextBox Text="{Binding SelectedCase.EvidenciaSha256}" 
                                                 IsReadOnly="True" 
                                                 BorderThickness="0" 
                                                 Background="#0F141C" 
                                                 Foreground="#34D399" 
                                                 FontFamily="Consolas, Monospace" 
                                                 FontSize="12"/>
                                    </StackPanel>
                                </Border>

                                <!-- Dictamen de la IA -->
                                <Border Background="#1E293B" CornerRadius="8" Padding="14">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="DICTAMEN PERICIAL (GENERADO POR IA)" FontSize="11" Foreground="#94A3B8" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding SelectedCase.DictamenPericial.ResumenForense}" 
                                                   TextWrapping="Wrap" 
                                                   LineHeight="22" 
                                                   Foreground="#E2E8F0"/>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- FOOTER: ESTADO Y BOTÓN DE MITIGACIÓN -->
                <Border Grid.Row="2"
                        Background="#161B22"
                        BorderBrush="#30363D"
                        BorderThickness="0 1 0 0"
                        Padding="16 10">
                    <Grid ColumnDefinitions="*,Auto">
                        <!-- Mensaje de estado y comando sugerido (solo si requiere acción) -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding StatusMessage}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#C9D1D9"/>
                            <TextBlock Text="{Binding SelectedCase.DictamenPericial.AccionPropuesta.ComandoSugerido}"
                                       FontSize="10"
                                       FontFamily="Consolas, monospace"
                                       Foreground="#7EE787"
                                       IsVisible="{Binding SelectedCase.DictamenPericial.AccionPropuesta.RequiereAccion}"/>
                        </StackPanel>

                        <!-- Botón Human-in-the-Loop: el analista aprueba la contramedida -->
                        <Button Grid.Column="1"
                                Command="{Binding ApplyRemediationActionCommand}"
                                IsEnabled="{Binding SelectedCase.DictamenPericial.AccionPropuesta.RequiereAccion}"
                                FontSize="11"
                                FontWeight="Bold"
                                Padding="16 8"
                                CornerRadius="6"
                                Background="#DA3633"
                                Foreground="White"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="🛡" VerticalAlignment="Center"/>
                                <TextBlock Text="Ejecutar Mitigación" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= CAPA B: INFORMES Y ESTADÍSTICAS ================= -->
            <!-- Carga el UserControl ReportsView -->
            <Border Background="#0F141C" IsVisible="{Binding IsReportsVisible}">
                <views:ReportsView />
            </Border>

        </Panel>
    </SplitView>
</Window>
