<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="tcg.Views.WarningDialog"
        Title="Aviso de Degradación de Servicio"
        Width="460" Height="220"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        CanResize="False"
        Background="Transparent">

    <!-- CONTENEDOR PRINCIPAL: TARJETA CON SOMBRA (la ventana no tiene barra de título) -->
    <!-- PointerPressed permite arrastrar la ventana desde cualquier punto -->
    <Border Background="#161B22"
            BorderBrush="#D29922"
            BorderThickness="1"
            CornerRadius="10"
            BoxShadow="0 8 24 0 #60000000"
            Padding="20"
            PointerPressed="OnPointerPressed">
        
        <Grid RowDefinitions="Auto,*,Auto">
            
            <!-- ================= 1. CABECERA ================= -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
                <TextBlock Text="⚠️" FontSize="20" VerticalAlignment="Center"/>
                <TextBlock Text="MODO DEGRADADO - MOTOR IA INACTIVO"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="#D29922"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- ================= 2. CUERPO DEL MENSAJE ================= -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0 10 0 10" Spacing="6">
                <TextBlock Text="No se pudo inicializar la conexión con Google Gemini."
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#FFFFFF"/>
                <!-- Detalle del error (puede sobrescribirse desde el code-behind) -->
                <TextBlock x:Name="TxtDetalleError"
                           Text="El sistema no podrá clasificar nuevos incidentes ni sugerir contramedidas en tiempo real. No obstante, puedes acceder al historial de casos y herramientas de análisis local."
                           FontSize="11"
                           Foreground="#8B949E"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- ================= 3. BOTÓN DE CIERRE ================= -->
            <!-- Cierra el aviso y continúa en modo degradado -->
            <Button Grid.Row="2"
                    Content="Entendido, continuar"
                    HorizontalAlignment="Right"
                    FontSize="11"
                    Padding="14 6"
                    Background="#21262D"
                    Foreground="#C9D1D9"
                    BorderBrush="#30363D"
                    BorderThickness="1"
                    CornerRadius="6"
                    Click="OnCloseClicked"/>
        </Grid>
    </Border>
</Window>
