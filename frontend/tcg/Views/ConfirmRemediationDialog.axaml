<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="tcg.Views.ConfirmRemediationDialog"
        Title="Confirmar Respuesta Activa"
        Width="480" Height="260"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        CanResize="False"
        Background="Transparent">

    <!-- CONTENEDOR PRINCIPAL: TARJETA CON SOMBRA (la ventana no tiene barra de título) -->
    <!-- PointerPressed permite arrastrar la ventana desde cualquier punto -->
    <Border Background="#161B22"
            BorderBrush="#30363D"
            BorderThickness="1"
            CornerRadius="10"
            BoxShadow="0 8 24 0 #60000000"
            Padding="22"
            PointerPressed="OnPointerPressed">

        <Grid RowDefinitions="Auto,*,Auto">
            
            <!-- ================= 1. CABECERA ================= -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
                <TextBlock Text="🛡" FontSize="20" VerticalAlignment="Center"/>
                <TextBlock Text="AUTORIZAR CONTRAMEDIDA ACTIVA"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="#58A6FF"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- ================= 2. DETALLE DE LA ACCIÓN ================= -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0 14 0 14" Spacing="8">
                <!-- Pregunta de confirmación (editable desde el code-behind) -->
                <TextBlock x:Name="TxtAccionTitulo"
                           Text="¿Desea ejecutar la siguiente mitigación en el servidor?"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#FFFFFF"/>

                <!-- Bloque de código con el comando a ejecutar -->
                <Border Background="#0D1117"
                        BorderBrush="#30363D"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10 8">
                    <TextBlock x:Name="TxtComando"
                               Text="iptables -I INPUT -s 192.168.56.10 -j DROP"
                               FontFamily="Consolas, Cascadia Code, monospace"
                               FontSize="11"
                               Foreground="#7EE787"/>
                </Border>

                <!-- Motivo por el que se propone la regla -->
                <TextBlock x:Name="TxtJustificacion"
                           Text="Justificación técnica de la regla."
                           FontSize="10"
                           Foreground="#8B949E"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- ================= 3. BOTONES DE ACCIÓN ================= -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <!-- Cierra el diálogo sin ejecutar nada -->
                <Button Content="Cancelar"
                        FontSize="11"
                        Padding="14 6"
                        Background="#21262D"
                        Foreground="#C9D1D9"
                        BorderBrush="#30363D"
                        BorderThickness="1"
                        CornerRadius="6"
                        Click="OnCancelClicked"/>

                <!-- Aprobación del analista (Human-in-the-Loop) -->
                <Button x:Name="BtnConfirmar"
                        Content="Autorizar y Ejecutar"
                        FontSize="11"
                        FontWeight="Bold"
                        Padding="14 6"
                        Background="#DA3633"
                        Foreground="White"
                        CornerRadius="6"
                        Click="OnConfirmClicked"/>
            </StackPanel>

        </Grid>
    </Border>
</Window>
